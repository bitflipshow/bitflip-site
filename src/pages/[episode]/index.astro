---
import Base from "../../layouts/Base.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";
import TranscriptRenderer from "../../components/TranscriptRenderer.astro";
import { getCollection } from "astro:content";
import { formatEpisodeDate } from "../../lib/episodes";
import { SITE } from "../lib/../../config";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes", ({ data }) => !data.draft);
  const allHosts = await getCollection("hosts");
  
  return episodes.map((episode) => {
    const episodeHostSlugs = episode.data.hosts || [];
    const episodeHosts = allHosts.filter((host) => 
      episodeHostSlugs.includes(host.slug)
    );
    
    return {
      params: { episode: String(episode.data.episodeNumber) },
      props: { episode, hosts: episodeHosts },
    };
  });
}

const { episode, hosts } = Astro.props;
const { Content } = await episode.render();
const { title, episodeNumber, date, summary, tags, coverImage, guests, sponsors, youtubeUrl } = episode.data;
const formattedDate = formatEpisodeDate(date);

const siteUrl = SITE.url;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": title,
  "description": summary,
  "episodeNumber": episodeNumber,
  "datePublished": date,
  "url": `${siteUrl}/${episodeNumber}`,
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": episode.data.audioUrl,
    "duration": episode.data.duration,
    "encodingFormat": "audio/mpeg"
  },
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": SITE.title,
    "url": SITE.url
  }
};
---

<Base
  title={`#${episodeNumber} — ${title} | BitFlip.show`}
  description={summary}
  ogImage={coverImage}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="episode-detail">
    <div class="detail-hero">
      <div class="detail-intro">
        <div class="section-title">Episode #{episodeNumber}</div>
        <h1 class="detail-title">{title}</h1>
        <div class="detail-date">{formattedDate}</div>
      </div>
      <p class="detail-summary">{summary}</p>
      {tags && tags.length > 0 && (
        <div class="detail-tags">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      )}
      {(episode.data.audioUrl || youtubeUrl) && (
        <div class="download-section">
          {episode.data.audioUrl && (
            <a href={episode.data.audioUrl} download class="download-link">
              <i class="fa-solid fa-download"></i> Download MP3
            </a>
          )}
          {youtubeUrl && (
            <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="download-link youtube-link">
              <i class="fa-brands fa-youtube"></i> Watch on YouTube
            </a>
          )}
        </div>
      )}
    </div>

    {(hosts && hosts.length > 0) || (guests && guests.length > 0) ? (
      <div class="people-section">
        {hosts && hosts.length > 0 && (
          <div class="people-group">
            <div class="section-title">Hosts</div>
            <div class="people-grid">
              {hosts.map((host) => (
                <a href={`/hosts/${host.slug}`} class="person-chip">
                  {host.data.avatar && (
                    <img src={host.data.avatar} alt={host.data.name} class="person-chip-avatar" />
                  )}
                  <span class="person-chip-name">{host.data.name}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        {guests && guests.length > 0 && (
          <div class="people-group">
            <div class="section-title">Guests</div>
            <div class="people-grid">
              {guests.map((guest) => (
                guest.link ? (
                  <a href={guest.link} target="_blank" rel="noopener noreferrer" class="person-chip" >
                    {guest.avatar && (
                      <img src={`/images/guests/${guest.avatar}`} alt={guest.name} class="person-chip-avatar" />
                    )}
                    <span class="person-chip-name">{guest.name}</span>
                    <i class="fa-solid fa-arrow-up-right-from-square person-chip-link-icon"></i>
                  </a>
                ) : (
                  <div class="person-chip" >
                    {guest.avatar && (
                      <img src={`/images/guests/${guest.avatar}`} alt={guest.name} class="person-chip-avatar" />
                    )}
                    <span class="person-chip-name">{guest.name}</span>
                  </div>
                )
              ))}
            </div>
          </div>
        )}
      </div>
    ) : null}

    {sponsors && sponsors.length > 0 && (
      <div class="sponsors-section">
        <div class="section-title">Sponsors</div>
        <div class="sponsors-grid">
          {sponsors.map((sponsor) => (
            <div class="sponsor-card" >
              <div class="sponsor-header">
                <span class="sponsor-name">{sponsor.name}</span>
                {sponsor.url && (
                  <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="sponsor-link">
                    Visit <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                )}
              </div>
              {sponsor.blurb && <p class="sponsor-blurb">{sponsor.blurb}</p>}
            </div>
          ))}
        </div>
      </div>
    )}
    
    <AudioPlayer episode={episode} />

    <div class="detail-notes">
      <Content />
    </div>

    <TranscriptRenderer />
  </article>
</Base>

<style>
  .episode-detail {
    display: grid;
    gap: 32px;
  }
  .episode-detail > * {
    min-width: 0;
  }
  .detail-hero {
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "intro"
      "summary"
      "tags"
      "actions";
    align-items: start;
  }
  .detail-intro {
    grid-area: intro;
    min-width: 0;
  }
  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 12px;
    line-height: 1.05;
  }
  .detail-date {
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
  }
  .detail-summary {
    grid-area: summary;
    color: var(--body-text);
    max-width: 640px;
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
  }
  .detail-tags {
    grid-area: tags;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }
  .tag:hover {
    background: rgba(243, 139, 18, 0.2);
    border-color: var(--safety-600);
    transform: translateY(-1px);
  }
  .download-section {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .youtube-link {
    border-color: #ff0000;
    color: #ff0000;
  }

  .youtube-link:hover {
    background: #ff0000;
    color: #fff;
  }
  .download-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 22px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    transition: background 0.2s, color 0.2s;
  }
  .download-link:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  /* People (hosts + guests) */
  .people-section {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .people-group {
    flex: 1;
    min-width: 0;
  }
  .people-group:first-child {
    flex: 3;
  }
  .people-grid {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .person-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 8px 14px;
    background: rgba(243, 139, 18, 0.08);
    border: 1px solid rgba(243, 139, 18, 0.25);
    border-radius: 999px;
    color: var(--steel-100);
    text-decoration: none;
    transition: var(--transition-card);
  }
  .person-chip:hover {
    background: rgba(243, 139, 18, 0.18);
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  .person-chip-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(243, 139, 18, 0.3);
    flex-shrink: 0;
  }
  .person-chip-name {
    font-weight: 600;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }
  .person-chip-link-icon {
    font-size: 0.7rem;
    color: var(--steel-500);
    margin-left: 2px;
  }

  /* Sponsors */
  .sponsors-section {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
  }
  .sponsors-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
  .sponsor-card {
    background: rgba(243, 139, 18, 0.05);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    display: grid;
    gap: 8px;
  }
  .sponsor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sponsor-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--steel-100);
  }
  .sponsor-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--safety-500);
    border: 1px solid rgba(243, 139, 18, 0.4);
    padding: 4px 12px;
    border-radius: 999px;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .sponsor-link:hover {
    background: rgba(243, 139, 18, 0.15);
    border-color: var(--safety-500);
  }
  .sponsor-blurb {
    color: var(--body-text);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .detail-notes {
    color: var(--body-text);
    line-height: 1.7;
    background: rgba(12, 14, 16, 0.45);
    border: 1px solid rgba(243, 139, 18, 0.12);
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .detail-notes :where(h2, h3, h4) {
    color: var(--steel-100);
    font-family: var(--font-display);
    line-height: 1.2;
  }

  .detail-notes :where(p, li) {
    overflow-wrap: anywhere;
  }

  .detail-notes :where(ul, ol) {
    padding-left: 1.2rem;
  }

  .detail-notes :where(a) {
    color: var(--safety-500);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  :global(.detail-notes a) {
    display: block;
    width: 100%;
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  .detail-notes :where(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .detail-notes :where(code) {
    overflow-wrap: anywhere;
  }

  .detail-notes :where(img, iframe, video) {
    max-width: 100%;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 860px) {
    .detail-hero {
      gap: 16px;
    }
    .people-section {
      flex-direction: column;
      gap: 20px;
    }
    .detail-title {
      font-size: clamp(1.5rem, 7vw, 2.2rem);
      margin-bottom: 8px;
    }
    .detail-summary {
      max-width: none;
      font-size: 0.98rem;
      line-height: 1.65;
    }
    .download-section {
      width: 100%;
    }
    .download-link {
      flex: 1 1 220px;
    }
  }

  @media (max-width: 560px) {
    .episode-detail {
      gap: 24px;
    }
    .detail-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "intro"
        "summary"
        "actions"
        "tags";
      gap: 12px;
    }
    .detail-intro {
      display: grid;
      gap: 6px;
    }
    .detail-title {
      font-size: clamp(1.7rem, 9vw, 2.1rem);
      margin-bottom: 0;
    }
    .detail-date {
      font-size: 0.72rem;
      letter-spacing: 0.08em;
    }
    .tag {
      padding: 5px 9px;
      font-size: 0.7rem;
    }
    .download-section {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .download-link {
      width: auto;
      padding: 12px 16px;
      font-size: 0.78rem;
      justify-content: flex-start;
      border-radius: 16px;
    }
    .people-section,
    .sponsors-section,
    .detail-notes {
      padding: 18px;
    }
    .people-grid {
      display: grid;
      grid-template-columns: 1fr;
    }
    .person-chip {
      width: 100%;
      border-radius: var(--radius-md);
      padding: 10px 12px;
    }
    .sponsor-card {
      padding: 14px;
    }
  }
</style>
