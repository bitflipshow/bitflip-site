---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes");
  
  // Collect all unique tags
  const allTags = new Set<string>();
  episodes.forEach((episode) => {
    (episode.data.tags || []).forEach((tag) => allTags.add(tag));
  });
  
  // Create a page for each tag
  return Array.from(allTags).map((tag) => {
    const taggedEpisodes = episodes
      .filter((episode) => (episode.data.tags || []).includes(tag))
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
    
    return {
      params: { slug: tag },
      props: { tag, episodes: taggedEpisodes },
    };
  });
}

const { tag, episodes } = Astro.props;
---

<Base title={`Tag: ${tag} | BitFlip.show`}>
  <section>
    <div class="tag-header">
      <div class="section-title">Tag</div>
      <h1 class="tag-name">
        <span class="tag-icon">#</span>{tag}
      </h1>
      <p class="tag-count">
        {episodes.length} {episodes.length === 1 ? 'episode' : 'episodes'}
      </p>
    </div>
    
    <div class="episodes-grid">
      {episodes.map((episode) => {
        const { title, episodeNumber, date, duration, summary } = episode.data;
        
        return (
          <article class="episode-card">
            <div class="episode-header">
              <div class="episode-number">#{episodeNumber}</div>
              <div class="episode-meta">
                <div class="episode-date">{date}</div>
                <div class="episode-duration">{duration}</div>
              </div>
            </div>
            <h3 class="episode-title">
              <a href={`/${episodeNumber}`}>{title}</a>
            </h3>
            <p class="episode-summary">{summary}</p>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .tag-header {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(243, 139, 18, 0.2);
  }
  
  .tag-name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .tag-icon {
    color: var(--safety-500);
  }
  
  .tag-count {
    color: var(--steel-400);
    font-size: 1rem;
    margin: 8px 0 0;
  }
  
  .episodes-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }
  
  .episode-card {
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(243, 139, 18, 0.2);
    background: rgba(12, 14, 16, 0.6);
    display: grid;
    gap: 12px;
    transition: border-color 0.2s, transform 0.2s;
  }
  
  .episode-card:hover {
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  
  .episode-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  
  .episode-number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--safety-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    color: var(--steel-500);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-date {
    color: var(--steel-500);
  }
  
  .episode-duration {
    color: var(--steel-400);
  }
  
  .episode-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  
  .episode-title a {
    color: var(--steel-100);
    transition: color 0.2s;
  }
  
  .episode-title a:hover {
    color: var(--safety-500);
  }
  
  .episode-summary {
    color: var(--steel-300);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
    
    .episode-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .episode-meta {
      align-items: flex-start;
    }
  }
</style>