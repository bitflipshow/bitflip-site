---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import EpisodeCard from "../../components/EpisodeCard.astro";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes", ({ data }) => !data.draft);
  
  const allTags = new Set<string>();
  episodes.forEach((episode) => {
    (episode.data.tags || []).forEach((tag) => allTags.add(tag.toLowerCase()));
  });
  
  return Array.from(allTags).map((tag) => {
    const taggedEpisodes = episodes
      .filter((episode) => 
        (episode.data.tags || []).map(t => t.toLowerCase()).includes(tag)
      )
      .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
    
    return {
      params: { slug: tag },
      props: { tag, episodes: taggedEpisodes },
    };
  });
}

const { tag, episodes } = Astro.props;
---

<Base title={`Tag: ${tag} | BitFlip.show`}>
  <section>
    <div class="tag-header">
      <div class="section-title">Tag</div>
      <h1 class="tag-name">
        <span class="tag-icon">#</span>{tag}
      </h1>
      <p class="tag-count">
        {episodes.length} {episodes.length === 1 ? 'episode' : 'episodes'}
      </p>
    </div>
    
    <div class="episodes-grid">
      {episodes.map((episode) => (
        <EpisodeCard episode={episode} />
      ))}
    </div>
  </section>
</Base>

<style>
  .tag-header {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(243, 139, 18, 0.2);
  }
  
  .tag-name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .tag-icon {
    color: var(--safety-500);
  }
  
  .tag-count {
    color: var(--meta-text);
    font-size: 1rem;
    margin: 8px 0 0;
  }
  
  .episodes-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>