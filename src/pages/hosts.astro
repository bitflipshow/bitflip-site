---
import Base from "../layouts/Base.astro";
import { getCollection, render } from "astro:content";

const hosts = await getCollection("hosts");
const episodes = await getCollection("episodes", ({ data }) => !data.draft);

// Count episodes per host
const episodeCounts = new Map<string, number>();
episodes.forEach((episode) => {
  const episodeHosts = episode.data.hosts || [];
  episodeHosts.forEach((hostId) => {
    episodeCounts.set(hostId, (episodeCounts.get(hostId) || 0) + 1);
  });
});

const sortedHosts = hosts.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));
---

<Base title="Hosts | BitFlip.show">
  <section>
    <h1 class="page-title">Hosts</h1>
    <div class="host-grid">
      {sortedHosts.map(async (host) => {
        const { Content } = await render(host);
        const { name, role, avatar, social } = host.data;
        const episodeCount = episodeCounts.get(host.id) || 0;
        
        return (
          <article class="host-card">
            {avatar && (
              <div class="host-avatar">
                <a href={`/hosts/${host.id}`}>
                  <img src={avatar} alt={name} />
                </a>
              </div>
            )}
            <div class="host-header">
              <div class="host-name">
                <a href={`/hosts/${host.id}`}>{name}</a>
              </div>
              {role && <div class="host-role">{role}</div>}
              <div class="host-episode-count">
                {episodeCount} {episodeCount === 1 ? 'episode' : 'episodes'}
              </div>
            </div>
            <div class="host-bio host-bio-excerpt">
              <Content />
            </div>
            <a href={`/hosts/${host.id}`} class="read-more">
              Read more →
            </a>
            {social && (
              <div class="host-social">
                {social.website && (
                  <a href={social.website} target="_blank" rel="noopener noreferrer" aria-label="Website">
                    <i class="fa-solid fa-globe"></i>
                  </a>
                )}
                {social.github && (
                  <a href={social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                  </a>
                )}
                {social.twitter && (
                  <a href={social.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                    <i class="fa-brands fa-twitter"></i>
                  </a>
                )}
                {social.mastodon && (
                  <a href={social.mastodon} target="_blank" rel="noopener noreferrer" aria-label="Mastodon">
                    <i class="fa-brands fa-mastodon"></i>
                  </a>
                )}
                {social.youtube && (
                  <a href={social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                    <i class="fa-brands fa-youtube"></i>
                  </a>
                )}
                {social.linkedin && (
                  <a href={social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                  </a>
                )}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .host-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }
  .host-card {
    padding: 24px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: 16px;
    transition: var(--transition-card);
  }
  .host-card:hover {
    border-color: var(--card-border-hover);
  }
  .host-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(243, 139, 18, 0.3);
    margin: 0 auto;
    transition: border-color 0.2s;
  }
  .host-avatar:hover {
    border-color: rgba(243, 139, 18, 0.6);
  }
  .host-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .host-header {
    text-align: center;
  }
  .host-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .host-name a {
    transition: color 0.2s;
  }
  .host-name a:hover {
    color: var(--safety-500);
  }
  .host-role {
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    margin-top: 4px;
  }
  .host-episode-count {
    color: var(--meta-text);
    font-size: 0.85rem;
    margin-top: 8px;
  }
  .host-bio {
    color: var(--body-text);
    line-height: 1.6;
  }
  .host-bio-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .host-bio :global(p) {
    margin: 0 0 12px;
  }
  .host-bio :global(p:last-child) {
    margin-bottom: 0;
  }
  .read-more {
    color: var(--safety-500);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    transition: color 0.2s;
  }
  .read-more:hover {
    color: var(--safety-600);
  }
  .host-social {
    display: flex;
    gap: 12px;
    justify-content: center;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .host-social a {
    color: var(--meta-text);
    font-size: 1.5rem;
    transition: var(--transition-color);
  }
  .host-social a:hover {
    color: var(--safety-500);
  }
  @media (max-width: 768px) {
    .host-grid {
      grid-template-columns: 1fr;
    }
  }
</style>