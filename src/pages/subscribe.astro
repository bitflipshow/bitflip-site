---
import Base from "../layouts/Base.astro";
import { SOCIAL } from "../config";
---

<Base title="Subscribe - BitFlip.show">
  <div class="subscribe-page">
    <h1 class="page-title">Subscribe to BitFlip</h1>
    <p class="intro">
      Stay up to date with the latest episodes of BitFlip. Choose your preferred platform below.
    </p>

    <div class="subscribe-options">
      <div class="subscribe-card">
        <div class="subscribe-icon">
          <i class="fa-solid fa-rss"></i>
        </div>
        <h2>RSS Feed</h2>
        <p>Subscribe via RSS in your favorite podcast app or feed reader.</p>
        <a href="/rss.xml" class="subscribe-button">
          <i class="fa-solid fa-rss"></i> RSS Feed
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon spotify">
          <i class="fa-brands fa-spotify"></i>
        </div>
        <h2>Spotify</h2>
        <p>Listen and subscribe on Spotify.</p>
        <a href={SOCIAL.spotify} target="_blank" rel="noopener noreferrer" class="subscribe-button spotify">
          <i class="fa-brands fa-spotify"></i> Listen on Spotify
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon podcastindex">
          <i class="fa-solid fa-podcast"></i>
        </div>
        <h2>Podcast Index</h2>
        <p>Find us on the Podcast Index — the open podcast database.</p>
        <a href={SOCIAL.podcastIndex} target="_blank" rel="noopener noreferrer" class="subscribe-button podcastindex">
          <i class="fa-solid fa-podcast"></i> Podcast Index
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon applepodcasts">
          <i class="fa-brands fa-apple"></i>
        </div>
        <h2>Apple Podcasts</h2>
        <p>Subscribe on Apple Podcasts.</p>
        <a href={SOCIAL.applePodcasts} target="_blank" rel="noopener noreferrer" class="subscribe-button applepodcasts">
          <i class="fa-brands fa-apple"></i> Apple Podcasts
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon pocketcasts">
          <i class="fa-solid fa-headphones"></i>
        </div>
        <h2>Pocket Casts</h2>
        <p>Subscribe on Pocket Casts.</p>
        <a href={SOCIAL.pocketCasts} target="_blank" rel="noopener noreferrer" class="subscribe-button pocketcasts">
          <i class="fa-solid fa-headphones"></i> Pocket Casts
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon podlink">
          <i class="fa-solid fa-link"></i>
        </div>
        <h2>PodLink</h2>
        <p>Find the show on your preferred app via PodLink.</p>
        <a href={SOCIAL.podLink} target="_blank" rel="noopener noreferrer" class="subscribe-button podlink">
          <i class="fa-solid fa-link"></i> PodLink
        </a>
      </div>

      <div class="subscribe-card">
        <div class="subscribe-icon youtube">
          <i class="fa-brands fa-youtube"></i>
        </div>
        <h2>YouTube</h2>
        <p>Watch episodes and subscribe to our channel on YouTube.</p>
        <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" class="subscribe-button youtube">
          <i class="fa-brands fa-youtube"></i> Watch on YouTube
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .subscribe-page {
    max-width: 1200px;
    margin: 0 auto;
  }

  .intro {
    font-size: 1.1rem;
    color: var(--body-text);
    margin-bottom: 48px;
  }

  .subscribe-options {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .subscribe-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: var(--transition-card);
  }

  .subscribe-card:hover {
    border-color: var(--card-border-hover);
    transform: translateY(-2px);
  }

  .subscribe-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(243, 139, 18, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 1.3rem;
    color: var(--safety-500);
  }

  .subscribe-icon.youtube {
    background: rgba(255, 0, 0, 0.1);
    color: #ff0000;
  }

  .subscribe-icon.spotify {
    background: rgba(30, 215, 96, 0.1);
    color: #1ed760;
  }

  .subscribe-card h2 {
    font-size: 1.1rem;
    margin-bottom: 8px;
    color: var(--steel-100);
  }

  .subscribe-card p {
    color: var(--body-text);
    font-size: 0.85rem;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .subscribe-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    transition: background 0.2s, color 0.2s;
  }

  .subscribe-button:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  .subscribe-button.youtube {
    border-color: #ff0000;
    color: #ff0000;
  }

  .subscribe-button.youtube:hover {
    background: #ff0000;
    color: white;
  }

  .subscribe-button.spotify {
    border-color: #1ed760;
    color: #1ed760;
  }

  .subscribe-button.spotify:hover {
    background: #1ed760;
    color: #000;
  }

  .subscribe-icon.podcastindex {
    background: rgba(247, 130, 0, 0.1);
    color: #f78200;
  }

  .subscribe-button.podcastindex {
    border-color: #f78200;
    color: #f78200;
  }

  .subscribe-button.podcastindex:hover {
    background: #f78200;
    color: #000;
  }

  .subscribe-icon.applepodcasts {
    background: rgba(177, 80, 226, 0.1);
    color: #b150e2;
  }

  .subscribe-button.applepodcasts {
    border-color: #b150e2;
    color: #b150e2;
  }

  .subscribe-button.applepodcasts:hover {
    background: #b150e2;
    color: #fff;
  }

  .subscribe-icon.pocketcasts {
    background: rgba(244, 62, 55, 0.1);
    color: #f43e37;
  }

  .subscribe-button.pocketcasts {
    border-color: #f43e37;
    color: #f43e37;
  }

  .subscribe-button.pocketcasts:hover {
    background: #f43e37;
    color: #fff;
  }

  .subscribe-icon.podlink {
    background: rgba(99, 100, 255, 0.1);
    color: #6364ff;
  }

  .subscribe-button.podlink {
    border-color: #6364ff;
    color: #6364ff;
  }

  .subscribe-button.podlink:hover {
    background: #6364ff;
    color: #fff;
  }

  @media (max-width: 1000px) {
    .subscribe-options {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .subscribe-options {
      grid-template-columns: 1fr;
    }
  }
</style>