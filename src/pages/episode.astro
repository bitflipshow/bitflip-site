---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const episodes = await getCollection("episodes");
const sortedEpisodes = episodes.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="Episodes | BitFlip.show">
  <section>
    <div class="section-title">All Episodes</div>
    <div class="episodes-grid">
      {sortedEpisodes.map((episode) => {
        const { title, episodeNumber, date, duration, tags } = episode.data;
        
        return (
          <article class="episode-card">
            <div class="episode-header">
              <div class="episode-number">#{episodeNumber}</div>
              <div class="episode-meta">
                <div class="episode-date">{date}</div>
                <div class="episode-duration">{duration}</div>
              </div>
            </div>
            <h3 class="episode-title">
              <a href={`/${episodeNumber}`}>{title}</a>
            </h3>
            {tags && tags.length > 0 && (
              <div class="episode-tags">
                {tags.map((tag) => (
                  <span class="tag" key={tag}>{tag}</span>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .episodes-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }
  
  .episode-card {
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(243, 139, 18, 0.2);
    background: rgba(12, 14, 16, 0.6);
    display: grid;
    gap: 12px;
    transition: border-color 0.2s, transform 0.2s;
  }
  
  .episode-card:hover {
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  
  .episode-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  
  .episode-number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--safety-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    color: var(--steel-500);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-date {
    color: var(--steel-500);
  }
  
  .episode-duration {
    color: var(--steel-400);
  }
  
  .episode-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  
  .episode-title a {
    color: var(--steel-100);
    transition: color 0.2s;
  }
  
  .episode-title a:hover {
    color: var(--safety-500);
  }
  
  .episode-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background-color 0.2s, color 0.2s;
  }
  
  .tag:hover {
    background-color: rgba(243, 139, 18, 0.1);
  }
  
  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
    
    .episode-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .episode-meta {
      align-items: flex-start;
    }
  }
</style>