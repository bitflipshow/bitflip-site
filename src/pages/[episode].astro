---
import Base from "../layouts/Base.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes");
  const allHosts = await getCollection("hosts");
  
  return episodes.map((episode) => {
    const episodeHostSlugs = episode.data.hosts || [];
    const episodeHosts = allHosts.filter((host) => 
      episodeHostSlugs.includes(host.slug)
    );
    
    return {
      params: { episode: String(episode.data.episodeNumber) },
      props: { episode, hosts: episodeHosts },
    };
  });
}

const { episode, hosts } = Astro.props;
const { Content } = await episode.render();
const { title, episodeNumber, date, summary, tags, coverImage } = episode.data;
---

<Base title={`#${episodeNumber} — ${title} | BitFlip.show`}>
  <article class="episode-detail">
    <div class="detail-hero">
      <div class="detail-cover">
        <img src={coverImage} alt={`${title} cover art`} />
      </div>
      <div>
        <div class="section-title">Episode #{episodeNumber}</div>
        <h1 class="detail-title">{title}</h1>
        <div class="detail-date">{date}</div>
        <p class="detail-summary">{summary}</p>
        {tags && tags.length > 0 && (
          <div class="detail-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag" key={tag}>#{tag}</a>
            ))}
          </div>
        )}
      </div>
    </div>
    
    {hosts && hosts.length > 0 && (
      <div class="episode-hosts">
        <div class="section-title">Hosts</div>
        <div class="hosts-grid">
          {hosts.map((host) => (
            <a href={`/hosts/${host.slug}`} class="host-chip" key={host.slug}>
              {host.data.avatar && (
                <img src={host.data.avatar} alt={host.data.name} class="host-chip-avatar" />
              )}
              <span class="host-chip-name">{host.data.name}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    
    <AudioPlayer episode={episode} />
    <div class="detail-notes">
      <Content />
    </div>
  </article>
</Base>

<style>
  .episode-detail {
    display: grid;
    gap: 32px;
  }
  .detail-hero {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    align-items: center;
  }
  .detail-cover {
    background: linear-gradient(160deg, var(--ink-800), var(--ink-700));
    border-radius: var(--radius-md);
    padding: 16px;
    border: 1px solid rgba(243, 139, 18, 0.2);
  }
  .detail-cover img {
    width: 100%;
    border-radius: 10px;
  }
  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 12px;
  }
  .detail-date {
    color: var(--steel-500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.8rem;
  }
  .detail-summary {
    color: var(--steel-300);
    max-width: 640px;
  }
  .detail-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }
  .tag:hover {
    background: rgba(243, 139, 18, 0.2);
    border-color: var(--safety-600);
    transform: translateY(-1px);
  }
  .episode-hosts {
    background: rgba(12, 14, 16, 0.6);
    border: 1px solid rgba(243, 139, 18, 0.2);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .hosts-grid {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .host-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: rgba(243, 139, 18, 0.1);
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: 999px;
    color: var(--steel-100);
    transition: all 0.2s;
  }
  .host-chip:hover {
    background: rgba(243, 139, 18, 0.2);
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  .host-chip-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(243, 139, 18, 0.3);
  }
  .host-chip-name {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .detail-notes {
    color: var(--steel-300);
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .detail-hero {
      grid-template-columns: 1fr;
    }
  }
</style>