---
import Base from "../layouts/Base.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import { getCollection } from "astro:content";
import { formatEpisodeDate } from "../lib/episodes";
import { SITE } from "../lib/../config";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes", ({ data }) => !data.draft);
  const allHosts = await getCollection("hosts");
  
  return episodes.map((episode) => {
    const episodeHostSlugs = episode.data.hosts || [];
    const episodeHosts = allHosts.filter((host) => 
      episodeHostSlugs.includes(host.slug)
    );
    
    return {
      params: { episode: String(episode.data.episodeNumber) },
      props: { episode, hosts: episodeHosts },
    };
  });
}

const { episode, hosts } = Astro.props;
const { Content } = await episode.render();
const { title, episodeNumber, date, summary, tags, coverImage, guests, sponsors, youtubeUrl } = episode.data;
const formattedDate = formatEpisodeDate(date);

const siteUrl = SITE.url;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": title,
  "description": summary,
  "episodeNumber": episodeNumber,
  "datePublished": date,
  "url": `${siteUrl}/${episodeNumber}`,
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": episode.data.audioUrl,
    "duration": episode.data.duration,
    "encodingFormat": "audio/mpeg"
  },
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": SITE.title,
    "url": SITE.url
  }
};
---

<Base
  title={`#${episodeNumber} — ${title} | BitFlip.show`}
  description={summary}
  ogImage={coverImage}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="episode-detail">
    <div class="detail-hero">
      <div class="detail-cover">
        <img src={coverImage} alt={`${title} cover art`} />
      </div>
      <div>
        <div class="section-title">Episode #{episodeNumber}</div>
        <h1 class="detail-title">{title}</h1>
        <div class="detail-date">{formattedDate}</div>
        <p class="detail-summary">{summary}</p>
        {tags && tags.length > 0 && (
          <div class="detail-tags">
            {tags.map((tag: string) => (
              <a href={`/tags/${tag}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
        {(episode.data.audioUrl || youtubeUrl) && (
          <div class="download-section">
            {episode.data.audioUrl && (
              <a href={episode.data.audioUrl} download class="download-link">
                <i class="fa-solid fa-download"></i> Download MP3
              </a>
            )}
            {youtubeUrl && (
              <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="download-link youtube-link">
                <i class="fa-brands fa-youtube"></i> Watch on YouTube
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    {(hosts && hosts.length > 0) || (guests && guests.length > 0) ? (
      <div class="people-section">
        {hosts && hosts.length > 0 && (
          <div class="people-group">
            <div class="section-title">Hosts</div>
            <div class="people-grid">
              {hosts.map((host) => (
                <a href={`/hosts/${host.slug}`} class="person-chip">
                  {host.data.avatar && (
                    <img src={host.data.avatar} alt={host.data.name} class="person-chip-avatar" />
                  )}
                  <span class="person-chip-name">{host.data.name}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        {guests && guests.length > 0 && (
          <div class="people-group">
            <div class="section-title">Guests</div>
            <div class="people-grid">
              {guests.map((guest) => (
                guest.link ? (
                  <a href={guest.link} target="_blank" rel="noopener noreferrer" class="person-chip" >
                    {guest.avatar && (
                      <img src={`/images/guests/${guest.avatar}`} alt={guest.name} class="person-chip-avatar" />
                    )}
                    <span class="person-chip-name">{guest.name}</span>
                    <i class="fa-solid fa-arrow-up-right-from-square person-chip-link-icon"></i>
                  </a>
                ) : (
                  <div class="person-chip" >
                    {guest.avatar && (
                      <img src={`/images/guests/${guest.avatar}`} alt={guest.name} class="person-chip-avatar" />
                    )}
                    <span class="person-chip-name">{guest.name}</span>
                  </div>
                )
              ))}
            </div>
          </div>
        )}
      </div>
    ) : null}

    {sponsors && sponsors.length > 0 && (
      <div class="sponsors-section">
        <div class="section-title">Sponsors</div>
        <div class="sponsors-grid">
          {sponsors.map((sponsor) => (
            <div class="sponsor-card" >
              <div class="sponsor-header">
                <span class="sponsor-name">{sponsor.name}</span>
                {sponsor.url && (
                  <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="sponsor-link">
                    Visit <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                )}
              </div>
              {sponsor.blurb && <p class="sponsor-blurb">{sponsor.blurb}</p>}
            </div>
          ))}
        </div>
      </div>
    )}
    
    <AudioPlayer episode={episode} />
    <div class="detail-notes">
      <Content />
    </div>
  </article>
</Base>

<style>
  .episode-detail {
    display: grid;
    gap: 32px;
  }
  .detail-hero {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    align-items: center;
  }
  .detail-cover {
    background: linear-gradient(160deg, var(--ink-800), var(--ink-700));
    border-radius: var(--radius-md);
    padding: 16px;
    border: 1px solid rgba(243, 139, 18, 0.2);
  }
  .detail-cover img {
    width: 100%;
    border-radius: 10px;
  }
  .detail-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 12px;
  }
  .detail-date {
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
  }
  .detail-summary {
    color: var(--body-text);
    max-width: 640px;
  }
  .detail-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }
  .tag:hover {
    background: rgba(243, 139, 18, 0.2);
    border-color: var(--safety-600);
    transform: translateY(-1px);
  }
  .download-section {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .youtube-link {
    border-color: #ff0000;
    color: #ff0000;
  }

  .youtube-link:hover {
    background: #ff0000;
    color: #fff;
  }
  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 22px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    transition: background 0.2s, color 0.2s;
  }
  .download-link:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  /* People (hosts + guests) */
  .people-section {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .people-group {
    flex: 1;
    min-width: 0;
  }
  .people-group:first-child {
    flex: 3;
  }
  .people-grid {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .person-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(243, 139, 18, 0.08);
    border: 1px solid rgba(243, 139, 18, 0.25);
    border-radius: 999px;
    color: var(--steel-100);
    text-decoration: none;
    transition: var(--transition-card);
  }
  .person-chip:hover {
    background: rgba(243, 139, 18, 0.18);
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  .person-chip-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(243, 139, 18, 0.3);
    flex-shrink: 0;
  }
  .person-chip-name {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .person-chip-link-icon {
    font-size: 0.7rem;
    color: var(--steel-500);
    margin-left: 2px;
  }

  /* Sponsors */
  .sponsors-section {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
  }
  .sponsors-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .sponsor-card {
    background: rgba(243, 139, 18, 0.05);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    display: grid;
    gap: 8px;
  }
  .sponsor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sponsor-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--steel-100);
  }
  .sponsor-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--safety-500);
    border: 1px solid rgba(243, 139, 18, 0.4);
    padding: 4px 12px;
    border-radius: 999px;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .sponsor-link:hover {
    background: rgba(243, 139, 18, 0.15);
    border-color: var(--safety-500);
  }
  .sponsor-blurb {
    color: var(--body-text);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .detail-notes {
    color: var(--body-text);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .detail-hero {
      grid-template-columns: 1fr;
    }
    .people-section {
      flex-direction: column;
      gap: 20px;
    }
  }
</style>