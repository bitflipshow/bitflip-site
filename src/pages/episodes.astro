---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const allEpisodes = await getCollection("episodes");
const sortedEpisodes = allEpisodes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Pagination settings
const EPISODES_PER_PAGE = 20;
const currentPage = 1;
const totalPages = Math.ceil(sortedEpisodes.length / EPISODES_PER_PAGE);
const startIndex = (currentPage - 1) * EPISODES_PER_PAGE;
const endIndex = startIndex + EPISODES_PER_PAGE;
const paginatedEpisodes = sortedEpisodes.slice(startIndex, endIndex);
---

<Base title="Episodes - BitFlip.show">
  <div class="episodes-page">
    <h1 class="page-title">All Episodes</h1>
    <div class="episodes-grid">
      {
        paginatedEpisodes.map((episode) => (
          <a href={`/${episode.slug}`} class="episode-card">
            <div class="episode-number">#{episode.data.number || episode.slug}</div>
            <h2>{episode.data.title}</h2>
            <p class="description">{episode.data.description}</p>
            <div class="episode-meta">
              <div class="date-runtime">
                <span class="date">
                  {new Date(episode.data.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </span>
                {episode.data.duration && (
                  <span class="runtime">
                    {episode.data.duration}
                  </span>
                )}
              </div>
              {episode.data.tags && episode.data.tags.length > 0 && (
                <div class="tags">
                  {episode.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>

    {totalPages > 1 && (
      <div class="pagination">
        {currentPage > 1 && (
          <a href={`/episodes/${currentPage - 1}`} class="page-link">
            Previous
          </a>
        )}
        <span class="page-info">
          Page {currentPage} of {totalPages}
        </span>
        {currentPage < totalPages && (
          <a href={`/episodes/${currentPage + 1}`} class="page-link">
            Next
          </a>
        )}
      </div>
    )}
  </div>
</Base>

<style>
  .episodes-page {
    max-width: 1200px;
    margin: 0 auto;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .episode-card {
    background: var(--ink-800);
    border: 1px solid rgba(243, 139, 18, 0.2);
    border-radius: 8px;
    padding: 24px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .episode-card:hover {
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }

  .episode-number {
    font-size: 0.875rem;
    color: var(--safety-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .episode-card h2 {
    font-size: 1.5rem;
    margin-bottom: 12px;
    color: var(--steel-100);
    line-height: 1.3;
  }

  .description {
    color: var(--steel-400);
    margin-bottom: 16px;
    flex-grow: 1;
    line-height: 1.6;
  }

  .episode-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(243, 139, 18, 0.1);
  }

  .date-runtime {
    display: flex;
    gap: 16px;
    font-size: 0.875rem;
  }

  .date {
    color: var(--steel-500);
  }

  .runtime {
    color: var(--steel-500);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(243, 139, 18, 0.1);
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--safety-500);
    text-transform: lowercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .page-link {
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .page-link:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  .page-info {
    color: var(--steel-400);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .episodes-grid {
      grid-template-columns: 1fr;
    }

    .episode-card h2 {
      font-size: 1.25rem;
    }
  }
</style>