---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const episodes = await getCollection("episodes");
const sortedEpisodes = episodes.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Pagination
const EPISODES_PER_PAGE = 20;
const currentPage = Number(Astro.url.searchParams.get("page") || "1");
const totalPages = Math.ceil(sortedEpisodes.length / EPISODES_PER_PAGE);
const startIndex = (currentPage - 1) * EPISODES_PER_PAGE;
const endIndex = startIndex + EPISODES_PER_PAGE;
const paginatedEpisodes = sortedEpisodes.slice(startIndex, endIndex);
---

<Base title="Episodes | BitFlip.show">
  <section>
    <div class="section-title">All Episodes</div>
    <div class="episodes-grid">
      {paginatedEpisodes.map((episode) => {
        const { title, episodeNumber, date, duration, tags } = episode.data;
        
        return (
          <article class="episode-card">
            <div class="episode-header">
              <div class="episode-number">#{episodeNumber}</div>
              <div class="episode-meta">
                <div class="episode-date">{date}</div>
                <div class="episode-duration">{duration}</div>
              </div>
            </div>
            <h3 class="episode-title">
              <a href={`/${episodeNumber}`}>{title}</a>
            </h3>
            {tags && tags.length > 0 && (
              <div class="episode-tags">
                {tags.map((tag) => (
                  <a href={`/tags/${tag}`} class="tag" key={tag}>#{tag}</a>
                ))}
              </div>
            )}
          </article>
        );
      })}
    </div>
    
    {totalPages > 1 && (
      <nav class="pagination">
        {currentPage > 1 && (
          <a href={`/episodes?page=${currentPage - 1}`} class="pagination-link">
            ← Previous
          </a>
        )}
        
        <div class="pagination-numbers">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
            <a 
              href={`/episodes?page=${page}`} 
              class={`pagination-number ${page === currentPage ? 'active' : ''}`}
              key={page}
            >
              {page}
            </a>
          ))}
        </div>
        
        {currentPage < totalPages && (
          <a href={`/episodes?page=${currentPage + 1}`} class="pagination-link">
            Next →
          </a>
        )}
      </nav>
    )}
  </section>
</Base>

<style>
  .episodes-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, 1fr);
  }
  
  .episode-card {
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(243, 139, 18, 0.2);
    background: rgba(12, 14, 16, 0.6);
    display: grid;
    gap: 12px;
    transition: border-color 0.2s, transform 0.2s;
  }
  
  .episode-card:hover {
    border-color: rgba(243, 139, 18, 0.5);
    transform: translateY(-2px);
  }
  
  .episode-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  
  .episode-number {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--safety-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    color: var(--steel-500);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  
  .episode-date {
    color: var(--steel-500);
  }
  
  .episode-duration {
    color: var(--steel-400);
  }
  
  .episode-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  
  .episode-title a {
    color: var(--steel-100);
    transition: color 0.2s;
  }
  
  .episode-title a:hover {
    color: var(--safety-500);
  }
  
  .episode-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }
  
  .tag:hover {
    background-color: rgba(243, 139, 18, 0.2);
    border-color: var(--safety-600);
  }
  
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(243, 139, 18, 0.2);
  }
  
  .pagination-link {
    padding: 10px 20px;
    border: 1px solid rgba(243, 139, 18, 0.4);
    border-radius: var(--radius-sm);
    color: var(--safety-500);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  
  .pagination-link:hover {
    background: rgba(243, 139, 18, 0.1);
    border-color: rgba(243, 139, 18, 0.6);
  }
  
  .pagination-numbers {
    display: flex;
    gap: 8px;
  }
  
  .pagination-number {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: var(--radius-sm);
    color: var(--steel-300);
    font-weight: 600;
    transition: all 0.2s;
  }
  
  .pagination-number:hover {
    background: rgba(243, 139, 18, 0.1);
    border-color: rgba(243, 139, 18, 0.5);
    color: var(--steel-100);
  }
  
  .pagination-number.active {
    background: var(--safety-500);
    border-color: var(--safety-500);
    color: var(--ink-900);
  }
  
  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
    
    .episode-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .episode-meta {
      align-items: flex-start;
    }
    
    .pagination {
      flex-wrap: wrap;
    }
    
    .pagination-numbers {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>