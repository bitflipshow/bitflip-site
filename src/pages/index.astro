---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import { SITE, SOCIAL } from "../config";

const episodes = (await getCollection("episodes", ({ data }) => !data.draft)).sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
const recentEpisodes = episodes.slice(0, 4);
---

<Base>
  <div class="home-page">
    <section class="hero-box">
      <h1 class="page-title">BitFlip.show</h1>
      <p class="tagline">
        We are getting the studio wired, the feed tuned, and the first episode ready to go out the door.
        Join Alex, Adam, Geoff, and Stephen as your hosts in a brand new, independent, podcast production.
      </p>

      <div class="links-section">
        <div class="link-group">
          <div class="section-label">SUBSCRIBE</div>
          <div class="link-buttons">
            <a href="/rss.xml" class="link-button rss">
              <i class="fa-solid fa-rss"></i>
              <span>RSS</span>
            </a>
            <a href={SOCIAL.spotify} target="_blank" rel="noopener noreferrer" class="link-button spotify">
              <i class="fa-brands fa-spotify"></i>
              <span>Spotify</span>
            </a>
            <a href={SOCIAL.podcastIndex} target="_blank" rel="noopener noreferrer" class="link-button podcastindex">
              <i class="fa-solid fa-podcast"></i>
              <span>Podcast Index</span>
            </a>
            <a href={SOCIAL.applePodcasts} target="_blank" rel="noopener noreferrer" class="link-button applepodcasts">
              <i class="fa-brands fa-apple"></i>
              <span>Apple Podcasts</span>
            </a>
            <a href={SOCIAL.pocketCasts} target="_blank" rel="noopener noreferrer" class="link-button pocketcasts">
              <i class="fa-solid fa-headphones"></i>
              <span>Pocket Casts</span>
            </a>
            <a href={SOCIAL.podLink} target="_blank" rel="noopener noreferrer" class="link-button podlink">
              <i class="fa-solid fa-link"></i>
              <span>PodLink</span>
            </a>
          </div>
        </div>

        <div class="link-group">
          <div class="section-label">FOLLOW</div>
          <div class="link-buttons">
            <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="link-button github">
              <i class="fa-brands fa-github"></i>
              <span>GitHub</span>
            </a>
            <a href={SOCIAL.mastodon} target="_blank" rel="noopener noreferrer" class="link-button mastodon">
              <i class="fa-brands fa-mastodon"></i>
              <span>Mastodon</span>
            </a>
            <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" class="link-button youtube">
              <i class="fa-brands fa-youtube"></i>
              <span>YouTube</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="recent-episodes">
      <h2>Recent Episodes</h2>
      <div class="episode-grid">
        {recentEpisodes.map((episode) => (
          <EpisodeCard episode={episode} />
        ))}
      </div>
      <div class="view-all">
        <a href="/episodes" class="view-all-button">
          View All Episodes <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .hero-box {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 48px 40px;
    margin-bottom: 60px;
  }

  .hero-box h1 {
    font-size: 2.5rem;
    margin-bottom: 16px;
    color: var(--steel-100);
    line-height: 1.2;
  }

  .tagline {
    font-size: 1rem;
    color: var(--body-text);
    max-width: 800px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .links-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .link-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-label {
    font-size: 0.75rem;
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    width: 80px;
    flex-shrink: 0;
  }

  .link-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .link-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: 999px;
    text-decoration: none;
    color: var(--steel-300);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .link-button:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .link-button i {
    font-size: 0.9rem;
  }

  .link-button.rss:hover     { color: var(--safety-500); border-color: var(--safety-500); }
  .link-button.spotify:hover { color: #1ed760;            border-color: #1ed760; }
  .link-button.youtube:hover { color: #ff0000;            border-color: #ff0000; }
  .link-button.github:hover  { color: #ffffff;            border-color: rgba(255,255,255,0.5); }
  .link-button.mastodon:hover    { color: #6364ff;            border-color: #6364ff; }
  .link-button.podcastindex:hover  { color: #f78200; border-color: #f78200; }
  .link-button.applepodcasts:hover { color: #b150e2; border-color: #b150e2; }
  .link-button.pocketcasts:hover    { color: #f43e37; border-color: #f43e37; }
  .link-button.podlink:hover         { color: #6364ff; border-color: #6364ff; }

  /* Recent episodes */
  .recent-episodes {
    margin-top: 60px;
  }

  .recent-episodes h2 {
    font-size: 1.5rem;
    margin-bottom: 24px;
    color: var(--steel-300);
  }

  .episode-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .view-all {
    text-align: center;
    margin-top: 32px;
  }

  .view-all-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .view-all-button:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  @media (max-width: 768px) {
    .hero-box {
      padding: 32px 24px;
    }

    .hero-box h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 0.95rem;
    }

    .link-group {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .section-label {
      width: auto;
    }

    .episode-grid {
      grid-template-columns: 1fr;
    }
  }
</style>