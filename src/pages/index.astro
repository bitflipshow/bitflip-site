---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EpisodeCard from "../components/EpisodeCard.astro";

const episodes = (await getCollection("episodes", ({ data }) => !data.draft)).sort((a, b) => {
  // Sort by date (descending - newest first)
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
const recentEpisodes = episodes.slice(0, 4);
---

<Base>
  <div class="home-page">
    <section class="hero-box">
      <h1 class="page-title">BitFlip.show</h1>
      <p class="tagline">
        We are getting the studio wired, the feed tuned, and the first episode ready to go out the door.
        Join Alex, Adam, Geoff, and Stephen as your hosts in a brand new, independent, podcast production.
      </p>
      
      <div class="links-section">
        <div class="subscribe-block">
          <div class="section-label">SUBSCRIBE</div>
          <div class="link-buttons">
            <a href="/rss.xml" class="link-button rss">
              <i class="fa-solid fa-rss"></i>
              <span>RSS</span>
            </a>
            <a href="https://www.youtube.com/@BitFlipShow" target="_blank" rel="noopener noreferrer" class="link-button youtube">
              <i class="fa-brands fa-youtube"></i>
              <span>YouTube</span>
            </a>
          </div>
        </div>
        
        <div class="follow-block">
          <div class="section-label">FOLLOW</div>
          <div class="link-buttons">
            <a href="https://github.com/bitflipshow" target="_blank" rel="noopener noreferrer" class="link-button github">
              <i class="fa-brands fa-github"></i>
              <span>GitHub</span>
            </a>
            <a href="https://techhub.social/@BitFlipShow" target="_blank" rel="noopener noreferrer" class="link-button mastodon">
              <i class="fa-brands fa-mastodon"></i>
              <span>Mastodon</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    
    <section class="recent-episodes">
      <h2>Recent Episodes</h2>
      <div class="episode-grid">
        {recentEpisodes.map((episode) => (
          <EpisodeCard episode={episode} />
        ))}
      </div>
      <div class="view-all">
        <a href="/episodes" class="view-all-button">
          View All Episodes <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .hero-box {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 48px 40px;
    margin-bottom: 60px;
  }

  .hero-box h1 {
    font-size: 2.5rem;
    margin-bottom: 16px;
    color: var(--steel-100);
    line-height: 1.2;
  }

  .tagline {
    font-size: 1rem;
    color: var(--body-text);
    max-width: 800px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .links-section {
    display: flex;
    gap: 48px;
    margin-top: 32px;
  }

  .subscribe-block,
  .follow-block {
    flex: 1;
  }

  .section-label {
    font-size: 0.85rem;
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .link-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .link-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--steel-300);
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    font-size: 0.9rem;
  }

  .link-button:hover {
    border-color: rgba(243, 139, 18, 0.6);
    background: rgba(0, 0, 0, 0.5);
  }

  .link-button i {
    font-size: 1rem;
  }

  .link-button.rss:hover {
    color: var(--safety-500);
  }

  .link-button.youtube:hover {
    color: #ff0000;
  }

  .link-button.github:hover {
    color: #ffffff;
  }

  .link-button.mastodon:hover {
    color: #6364ff;
  }

  .recent-episodes {
    margin-top: 60px;
  }

  .recent-episodes h2 {
    font-size: 1.5rem;
    margin-bottom: 24px;
    color: var(--steel-300);
  }

  .episode-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  .view-all {
    text-align: center;
    margin-top: 32px;
  }

  .view-all-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .view-all-button:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }

  @media (max-width: 768px) {
    .hero-box {
      padding: 32px 24px;
    }

    .hero-box h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 0.95rem;
    }

    .links-section {
      flex-direction: column;
      gap: 24px;
    }

    .episode-grid {
      grid-template-columns: 1fr;
    }
  }
</style>