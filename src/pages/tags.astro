---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { slugifyTag } from "../lib/tags";

const episodes = await getCollection("episodes", ({ data }) => !data.draft);

// Count episodes per tag slug, keeping a display label
const tagCounts = new Map<string, { label: string; count: number }>();
episodes.forEach((episode) => {
  (episode.data.tags || []).forEach((tag) => {
    const slug = slugifyTag(tag);
    const entry = tagCounts.get(slug);
    if (entry) {
      entry.count += 1;
    } else {
      tagCounts.set(slug, { label: tag.toLowerCase(), count: 1 });
    }
  });
});

// Sort tags by count (descending), then alphabetically
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => {
    if (b[1].count !== a[1].count) return b[1].count - a[1].count; // Sort by count
    return a[0].localeCompare(b[0]); // Then alphabetically
  });
---

<Base title="Tags | BitFlip.show">
  <section>
    <div class="section-title">Browse by Tag</div>
    <div class="tags-cloud">
      {sortedTags.map(([slug, { label, count }]) => (
        <a href={`/tags/${slug}`} class="tag-chip">
          <span class="tag-name">#{label}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  
  .tag-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 999px;
    color: var(--steel-100);
    transition: all 0.2s;
  }
  
  .tag-chip:hover {
    background: rgba(243, 139, 18, 0.1);
    border-color: var(--card-border-hover);
    transform: var(--card-hover-transform);
  }
  
  .tag-name {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: lowercase;
  }
  
  .tag-count {
    background: rgba(243, 139, 18, 0.2);
    color: var(--safety-500);
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>