---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";

const allEpisodes = await getCollection("episodes", ({ data }) => !data.draft);
const sortedEpisodes = allEpisodes.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const PAGE_SIZE = 20;
const totalPages = Math.ceil(sortedEpisodes.length / PAGE_SIZE);
const pageEpisodes = sortedEpisodes.slice(0, PAGE_SIZE);
---

<Base title="Episodes | BitFlip.show">
  <div class="episodes-page">
    <h1 class="page-title">All Episodes</h1>
    <div class="episodes-grid">
      {pageEpisodes.map((episode) => (
        <EpisodeCard episode={episode} />
      ))}
    </div>

    {totalPages > 1 && (
      <div class="pagination">
        <span class="page-info">Page 1 of {totalPages}</span>
        <a href="/episodes/2" class="page-link">Next →</a>
      </div>
    )}
  </div>
</Base>

<style>
  .episodes-page {
    max-width: 1200px;
    margin: 0 auto;
  }
  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }
  .page-link {
    padding: 11px 22px;
    background: transparent;
    border: 1px solid var(--safety-500);
    color: var(--safety-500);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
    transition: background 0.2s, color 0.2s;
  }
  .page-link:hover {
    background: var(--safety-500);
    color: var(--ink-900);
  }
  .page-info {
    color: var(--meta-text);
    font-size: 0.875rem;
  }
  @media (max-width: 768px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>