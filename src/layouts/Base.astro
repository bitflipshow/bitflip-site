---
import "../styles/theme.css";
import StickyPlayer from "../components/StickyPlayer.astro";
import { ClientRouter } from 'astro:transitions';
import { SITE, SOCIAL } from "../config";

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.coverImage,
  ogType = "website",
  hideNav = false,
  hidePlayer = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://bitflip.show");
const ogImageURL = new URL(ogImage, Astro.site ?? "https://bitflip.show");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      referrerpolicy="no-referrer"
    />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script
      defer
      data-domain="bitflip.show"
      src="https://plausible.ktz.cloud/js/script.js"
    ></script>
    <link rel="alternate" type="application/rss+xml" title="BitFlip.show Podcast Feed" href="/rss.xml" />
    <slot name="head" />
    <ClientRouter />
    <style>
      .site-footer {
        padding: 24px 0 16px;
        border-top: 1px solid rgba(243, 139, 18, 0.12);
        margin-top: 60px;
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        color: var(--steel-500);
        font-size: 0.85rem;
      }

      .footer-links {
        display: flex;
        gap: 20px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .footer-links a {
        color: var(--steel-500);
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--steel-300);
      }

      @media (max-width: 480px) {
        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header container">
      <div class="brand">
        <img class="brand-logo" src="/images/bitflip-logo.png" alt="BitFlip logo" />
        <div>
          <div class="site-title">
            <a href="/">{SITE.title}</a>
          </div>
          <div class="site-tagline">{SITE.tagline}</div>
        </div>
      </div>
      {!hideNav && (
        <>
          <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
            <i class="fa-solid fa-bars"></i>
          </button>
          <nav id="main-nav" class="nav-links" aria-label="Main navigation">
            <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>
            <a href="/episodes" aria-current={Astro.url.pathname.startsWith('/episodes') ? 'page' : undefined}>Episodes</a>
            <a href="/hosts" aria-current={Astro.url.pathname === '/hosts' ? 'page' : undefined}>Hosts</a>
            <a href="/subscribe" aria-current={Astro.url.pathname === '/subscribe' ? 'page' : undefined}>Subscribe</a>
            <a href="/search" aria-current={Astro.url.pathname === '/search' ? 'page' : undefined}>Search</a>
            <a href={SOCIAL.discord} target="_blank" rel="noopener noreferrer">Discord</a>
            <a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contact</a>
          </nav>
        </>
      )}
    </header>
    <main class="container" data-pagefind-body>
      <slot />
      <footer class="site-footer">
        <div class="footer-inner">
          <span class="footer-copy">© {new Date().getFullYear()} BitFlip.show</span>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="/about">About</a>
            <a href="/subscribe">Subscribe</a>
            <a href="/contact">Contact</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </footer>
    </main>
    {!hidePlayer && <StickyPlayer />}
    <script is:inline>
      function initNav() {
        const toggle = document.querySelector('.nav-toggle');
        const nav = document.getElementById('main-nav');
        if (!toggle || !nav) return;

        // Remove any existing cloned listener by replacing the node
        const freshToggle = toggle.cloneNode(true);
        toggle.parentNode.replaceChild(freshToggle, toggle);

        freshToggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('is-open');
          freshToggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
      document.addEventListener('astro:page-load', initNav);
    </script>
  </body>
</html>
