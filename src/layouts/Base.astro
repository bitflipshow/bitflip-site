---
import "../styles/theme.css";
import StickyPlayer from "../components/StickyPlayer.astro";
import { ClientRouter } from 'astro:transitions';
import { SITE, SOCIAL } from "../config";

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.coverImage,
  ogType = "website",
  hideNav = false,
  hidePlayer = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://bitflip.show");
const ogImageURL = new URL(ogImage, Astro.site ?? "https://bitflip.show");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <!-- Web App Manifest (Android / Chrome "Add to Home Screen") -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Browser chrome color on mobile -->
    <meta name="theme-color" content="#0f1117" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      referrerpolicy="no-referrer"
    />
    <script
      defer
      data-domain="bitflip.show"
      src="https://plausible.ktz.cloud/js/script.js"
    ></script>
    <link rel="alternate" type="application/rss+xml" title={`${SITE.podcastTitle} Podcast Feed`} href="/rss.xml" />
    <slot name="head" />
    <ClientRouter />
    <style>
      .site-footer {
        padding: 24px 0 16px;
        border-top: 1px solid rgba(243, 139, 18, 0.12);
        margin-top: 60px;
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-copy {
        color: var(--steel-500);
        font-size: 0.85rem;
      }

      .footer-links {
        display: flex;
        gap: 20px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .footer-links a {
        color: var(--steel-500);
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--steel-300);
      }

      @media (max-width: 480px) {
        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header container">
      <div class="brand">
        <img class="brand-logo" src="/images/bitflip-logo.png" alt="BitFlip logo" />
        <div>
          <div class="site-title">
            <a href="/">{SITE.title}</a>
          </div>
          <div class="site-tagline">{SITE.tagline}</div>
        </div>
      </div>
      {!hideNav && (
        <>
          <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
            <i class="fa-solid fa-bars"></i>
          </button>
          <nav id="main-nav" class="nav-links" aria-label="Main navigation">
            <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>
            <a href="/episodes" aria-current={Astro.url.pathname.startsWith('/episodes') ? 'page' : undefined}>Episodes</a>
            <a href="/hosts" aria-current={Astro.url.pathname === '/hosts' ? 'page' : undefined}>Hosts</a>
            <a href="/subscribe" aria-current={Astro.url.pathname === '/subscribe' ? 'page' : undefined}>Subscribe</a>
            <a href="/support" aria-current={Astro.url.pathname === '/support' ? 'page' : undefined}>Support</a>
            <a href="/search" aria-current={Astro.url.pathname === '/search' ? 'page' : undefined}>Search</a>
            <a href={SOCIAL.discord} target="_blank" rel="noopener noreferrer">Discord</a>

          </nav>
        </>
      )}
    </header>
    <main class="container" data-pagefind-body>
      <slot />
      <footer class="site-footer">
        <div class="footer-inner">
          <span class="footer-copy">© {new Date().getFullYear()} BitFlip.show</span>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="/about">About</a>
            <a href="/subscribe">Subscribe</a>
            <a href="/support">Support</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </footer>
    </main>
    {!hidePlayer && <StickyPlayer />}
    <script>
      function transcriptInitPage(): "done" | "retry" {
        const notes = document.querySelector(".detail-notes");
        if (!notes) return "done";
        if (!notes.firstElementChild) return "retry";
        if (document.querySelector(".transcript-section")) return "done";

        const headings = notes.querySelectorAll("h2");
        let transcriptHeading: Element | null = null;
        for (const h of headings) {
          if (h.textContent!.trim().toLowerCase() === "transcript") {
            transcriptHeading = h;
            break;
          }
        }
        if (!transcriptHeading) return "done";

        const transcriptNodes: Element[] = [];
        let node = transcriptHeading.nextElementSibling;
        while (node && node.tagName !== "H2") {
          transcriptNodes.push(node);
          node = node.nextElementSibling;
        }

        interface Cue { speaker: string; text: string; timestamp: string | null }
        const cues: Cue[] = [];
        for (const el of transcriptNodes) {
          const paras = el.matches("p") ? [el] : Array.from(el.querySelectorAll("p"));
          for (const p of paras) {
            const strong = p.querySelector("strong");
            const em = p.querySelector("em");
            if (!strong) continue;
            const speaker = strong.textContent!.trim();
            const timestamp = em ? em.textContent!.trim() : null;
            let text = p.textContent!;
            text = text.replace(/^[^:]+:\s*/, "");
            if (timestamp) text = text.replace(timestamp, "").trim();
            text = text.replace(/\*$/, "").trim();
            if (speaker && text) cues.push({ speaker, text, timestamp });
          }
        }
        if (!cues.length) return "done";

        transcriptHeading.remove();
        for (const el of transcriptNodes) el.remove();
        notes.insertAdjacentElement("afterend", buildTranscriptWidget(cues));
        return "done";
      }

      interface Turn { speaker: string; timestamp: string | null; lines: string[] }
      function buildTranscriptWidget(cues: { speaker: string; text: string; timestamp: string | null }[]): HTMLElement {
        const turns: Turn[] = [];
        for (const cue of cues) {
          const last = turns[turns.length - 1];
          if (last && last.speaker === cue.speaker && !cue.timestamp) {
            last.lines.push(cue.text);
          } else {
            turns.push({ speaker: cue.speaker, timestamp: cue.timestamp, lines: [cue.text] });
          }
        }
        const speakerMap = new Map<string, number>();
        let colorIdx = 0;
        for (const t of turns) {
          if (!speakerMap.has(t.speaker)) speakerMap.set(t.speaker, colorIdx++ % 6);
        }

        const section = document.createElement("div");
        section.className = "transcript-section";

        const toggle = document.createElement("button");
        toggle.type = "button";
        toggle.className = "transcript-toggle";
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-controls", "transcript-body");
        toggle.innerHTML =
          '<span class="transcript-toggle-left">' +
          '<i class="fa-solid fa-file-lines transcript-icon"></i>' +
          '<span class="transcript-label">' +
          '<span class="transcript-title">Transcript</span>' +
          '<span class="transcript-subtitle">' + turns.length + " speaker turns</span>" +
          "</span></span>" +
          '<span class="transcript-chevron" aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>';
        section.appendChild(toggle);

        const body = document.createElement("div");
        body.id = "transcript-body";
        body.className = "transcript-body";
        body.hidden = true;

        const toolbar = document.createElement("div");
        toolbar.className = "transcript-toolbar";
        const copyBtn = document.createElement("button");
        copyBtn.type = "button";
        copyBtn.className = "transcript-tool-btn";
        copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy';
        toolbar.appendChild(copyBtn);
        body.appendChild(toolbar);

        const content = document.createElement("div");
        content.className = "transcript-content";
        const dialogue = document.createElement("div");
        dialogue.className = "transcript-dialogue";
        for (const turn of turns) {
          const row = document.createElement("div");
          row.className = "transcript-turn speaker-color-" + speakerMap.get(turn.speaker);
          const meta = document.createElement("div");
          meta.className = "turn-meta";
          meta.innerHTML =
            '<span class="turn-speaker">' + escHtml(turn.speaker) + "</span>" +
            (turn.timestamp ? '<span class="turn-ts">' + escHtml(turn.timestamp) + "</span>" : "");
          const textWrap = document.createElement("div");
          textWrap.className = "turn-text";
          textWrap.textContent = turn.lines.join(" ");
          row.appendChild(meta);
          row.appendChild(textWrap);
          dialogue.appendChild(row);
        }
        content.appendChild(dialogue);
        body.appendChild(content);
        section.appendChild(body);

        copyBtn.addEventListener("click", () => {
          const plain = turns.map(t => "[" + (t.timestamp || "") + "] " + t.speaker + ": " + t.lines.join(" ")).join("\n\n");
          navigator.clipboard.writeText(plain).then(() => {
            copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
            setTimeout(() => { copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy'; }, 2000);
          }).catch(() => {});
        });

        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!open));
          body.hidden = open;
        });

        return section;
      }

      function escHtml(s: string) {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      function tryTranscriptInit(n: number) {
        if (transcriptInitPage() === "retry" && n > 0) setTimeout(() => tryTranscriptInit(n - 1), 100);
      }

      document.addEventListener("astro:page-load", () => tryTranscriptInit(20));
    </script>
    <script is:inline>
      function initNav() {
        const toggle = document.querySelector('.nav-toggle');
        const nav = document.getElementById('main-nav');
        if (!toggle || !nav) return;

        // Remove any existing cloned listener by replacing the node
        const freshToggle = toggle.cloneNode(true);
        toggle.parentNode.replaceChild(freshToggle, toggle);

        freshToggle.addEventListener('click', () => {
          const isOpen = nav.classList.toggle('is-open');
          freshToggle.setAttribute('aria-expanded', String(isOpen));
        });
      }
      document.addEventListener('astro:page-load', initNav);
    </script>
  </body>
</html>
