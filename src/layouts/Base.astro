---
import "../styles/theme.css";
import StickyPlayer from "../components/StickyPlayer.astro";
import { ClientRouter } from 'astro:transitions';

const {
  title = "BitFlip.show",
  hideNav = false,
  hidePlayer = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      referrerpolicy="no-referrer"
    />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script
      defer
      data-domain="bitflip.show"
      src="https://plausible.ktz.cloud/js/script.js"
    ></script>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header container">
      <div class="brand">
        <img class="brand-logo" src="/images/bitflip-logo.png" alt="BitFlip logo" />
        <div>
          <div class="site-title">
            <a href="/">BitFlip.show</a>
          </div>
          <div class="site-tagline">The pragmatic side of infrastructure.</div>
        </div>
      </div>
      {!hideNav && (
        <nav class="nav-links">
          <a href="/about">About</a>
          <a href="/episodes">Episodes</a>
          <a href="/hosts">Hosts</a>
          <a href="/subscribe">Subscribe</a>
          <a href="/search">Search</a>
          <a href="https://discord.gg/XYZPDQ" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="/contact">Contact</a>
        </nav>
      )}
    </header>
    <main class="container" data-pagefind-body>
      <slot />
    </main>
    {!hidePlayer && <StickyPlayer />}
  </body>
</html>