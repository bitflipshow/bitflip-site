---
import { parseChapterTime } from "../lib/chapters";

const { episode } = Astro.props;
const { title, episodeNumber, duration, audioUrl, chapters, youtubeUrl } = episode.data;
const playerId = `episode-player-${episodeNumber}`;
const chapterItems = (chapters ?? []).map((chapter: { time: string; title: string }) => ({
  ...chapter,
  seconds: parseChapterTime(chapter.time),
}));
---

<div
  id={playerId}
  class="episode-player"
  data-src={audioUrl}
  data-title={title}
  data-episode={episodeNumber}
>
  <div class="player-header">
    <div>
      <div class="section-title">Listen</div>
      <div class="player-title">{title}</div>
      <div class="player-meta">Duration {duration}</div>
    </div>
    <button class="button" type="button" data-play>
      Play
    </button>
  </div>
  {(chapterItems.length > 0 || youtubeUrl) && (
    <div class="player-media">
      {youtubeUrl && (() => {
        const ytUrl = new URL(youtubeUrl);
        const videoId = ytUrl.hostname === "youtu.be"
          ? ytUrl.pathname.slice(1)
          : ytUrl.searchParams.get("v");
        return videoId ? (
          <div class="player-youtube">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              title={`${title} on YouTube`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ) : null;
      })()}
      {chapterItems.length > 0 && (
        <div class="player-chapters-wrap">
          {chapterItems.length > 6 && (
            <div class="chapters-hint">
              <i class="fa-solid fa-list"></i>
              {chapterItems.length} chapters
            </div>
          )}
          <div class="player-chapters">
            {chapterItems.map((chapter: { time: string; title: string; seconds: number }) => (
              <button class="chapter" type="button" data-seek={chapter.seconds}>
                <span class="chapter-time">{chapter.time}</span>
                <span>{chapter.title}</span>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</div>

<script type="module" define:vars={{ playerId }}>
  const root = document.getElementById(playerId);
  if (!root) {
    console.warn("BitFlip player root not found", playerId);
  }
  const playButton = root?.querySelector("[data-play]");
  const chapters = root?.querySelectorAll("[data-seek]") ?? [];

  // The global audio element lives in the StickyPlayer
  const getAudio = () => document.getElementById("global-audio");

  // Returns true if the global audio is currently playing THIS episode
  const isThisEpisodePlaying = () => {
    const audio = getAudio();
    return audio && !audio.paused && audio.src === root.dataset.src;
  };

  const syncButton = () => {
    if (!playButton) return;
    if (isThisEpisodePlaying()) {
      playButton.textContent = "Pause";
      playButton.setAttribute("aria-label", "Pause episode");
    } else {
      playButton.textContent = "Play";
      playButton.setAttribute("aria-label", "Play episode");
    }
  };

  // Sync on audio play/pause events
  document.addEventListener("play", syncButton, true);
  document.addEventListener("pause", syncButton, true);

  // Also sync when a different episode starts playing
  // (so this button reverts to "Play" if another episode is triggered)
  window.addEventListener("bitflip:play", syncButton);

  // Sync initial state in case the page loaded mid-playback
  syncButton();

  playButton?.addEventListener("click", () => {
    const audio = getAudio();
    if (isThisEpisodePlaying()) {
      // This episode is playing — pause it
      audio.pause();
    } else {
      // Either nothing is playing, or a different episode is — start this one
      window.dispatchEvent(new CustomEvent("bitflip:play", {
        detail: {
          src: root.dataset.src,
          title: root.dataset.title,
          episodeNumber: Number(root.dataset.episode),
        },
      }));
    }
  });

  chapters.forEach((button) => {
    button.addEventListener("click", () => {
      const seconds = Number(button.dataset.seek);
      const audio = getAudio();

        if (audio && audio.src === root.dataset.src) {
          // Already the active episode — seek and ensure playing
          window.dispatchEvent(new CustomEvent("bitflip:seek", { detail: { seconds } }));
          audio.play();
        } else {
        // Different or no episode loaded — start it, then seek once audio is ready
        window.dispatchEvent(new CustomEvent("bitflip:play", {
          detail: {
            src: root.dataset.src,
            title: root.dataset.title,
            episodeNumber: Number(root.dataset.episode),
          },
        }));
        const targetAudio = getAudio();
        const onCanPlay = () => {
          targetAudio.removeEventListener("canplay", onCanPlay);
          window.dispatchEvent(new CustomEvent("bitflip:seek", { detail: { seconds } }));
        };
        targetAudio?.addEventListener("canplay", onCanPlay);
      }
    });
  });
</script>

<style>
  .episode-player {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px;
    display: grid;
    gap: 16px;
  }
  .player-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .player-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .player-meta {
    color: var(--meta-text);
    font-size: 0.9rem;
  }

  /* Chapters wrapper — handles scroll + fade hint */
  .player-chapters-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .chapters-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .player-chapters {
    display: grid;
    gap: 6px;
    max-height: 260px;
    overflow-y: auto;
    /* Fade out at the bottom to hint at scrollability */
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    padding-right: 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(243, 139, 18, 0.3) transparent;
  }

  .player-chapters::-webkit-scrollbar {
    width: 4px;
  }
  .player-chapters::-webkit-scrollbar-track {
    background: transparent;
  }
  .player-chapters::-webkit-scrollbar-thumb {
    background: rgba(243, 139, 18, 0.3);
    border-radius: 2px;
  }

  .chapter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px 12px;
    align-items: start;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    color: var(--steel-300);
    padding: 8px 12px;
    text-align: left;
    cursor: pointer;
    width: 100%;
    flex-shrink: 0;
  }
  .chapter:hover {
    border-color: rgba(243, 139, 18, 0.5);
    color: var(--steel-100);
  }
  .chapter-time {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--safety-500);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .player-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .player-media > :only-child {
    grid-column: 1 / -1;
  }
  .player-youtube {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    aspect-ratio: 16 / 9;
  }
  .player-youtube iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  @media (max-width: 720px) {
    .player-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .player-header .button {
      width: 100%;
      justify-content: center;
    }

    .player-media {
      grid-template-columns: 1fr;
    }

    .player-chapters {
      max-height: 320px;
    }
  }

  @media (max-width: 560px) {
    .episode-player {
      padding: 16px;
      gap: 14px;
    }

    .player-title {
      font-size: 1.1rem;
    }

    .chapter {
      padding: 10px 12px;
      border-radius: var(--radius-md);
    }
  }
</style>
