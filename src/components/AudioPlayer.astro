---
import { parseChapterTime } from "../lib/chapters";

const { episode } = Astro.props;
const { title, episodeNumber, duration, audioUrl, chapters, youtubeUrl } = episode.data;
const playerId = `episode-player-${episodeNumber}`;
const chapterItems = (chapters ?? []).map((chapter: { time: string; title: string }) => ({
  ...chapter,
  seconds: parseChapterTime(chapter.time),
}));
---

<div
  id={playerId}
  class="episode-player"
  data-src={audioUrl}
  data-title={title}
  data-episode={episodeNumber}
>
  <div class="player-header">
    <div>
      <div class="section-title">Listen</div>
      <div class="player-title">{title}</div>
      <div class="player-meta">Duration {duration}</div>
    </div>
    <button class="button" type="button" data-play>
      Play
    </button>
  </div>
  {(chapterItems.length > 0 || youtubeUrl) && (
    <div class="player-media">
      {youtubeUrl && (() => {
        const videoId = new URL(youtubeUrl).searchParams.get("v");
        return videoId ? (
          <div class="player-youtube">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              title={`${title} on YouTube`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        ) : null;
      })()}
      {chapterItems.length > 0 && (
        <div class="player-chapters">
          {chapterItems.map((chapter: { time: string; title: string; seconds: number }) => (
            <button class="chapter" type="button" data-seek={chapter.seconds}>
              <span class="chapter-time">{chapter.time}</span>
              <span>{chapter.title}</span>
            </button>
          ))}
        </div>
      )}
    </div>
  )}
</div>

<script type="module" define:vars={{ playerId }}>
  const root = document.getElementById(playerId);
  if (!root) {
    console.warn("BitFlip player root not found", playerId);
  }
  const playButton = root?.querySelector("[data-play]");
  const chapters = root?.querySelectorAll("[data-seek]") ?? [];

  playButton?.addEventListener("click", () => {
    const detail = {
      src: root.dataset.src,
      title: root.dataset.title,
      episodeNumber: Number(root.dataset.episode),
    };
    window.dispatchEvent(new CustomEvent("bitflip:play", { detail }));
  });

  chapters.forEach((button) => {
    button.addEventListener("click", () => {
      const seconds = Number(button.dataset.seek);
      window.dispatchEvent(
        new CustomEvent("bitflip:seek", { detail: { seconds } })
      );
    });
  });
</script>

<style>
  .episode-player {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px;
    display: grid;
    gap: 16px;
  }
  .player-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .player-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .player-meta {
    color: var(--meta-text);
    font-size: 0.9rem;
  }
  .player-chapters {
    display: grid;
    gap: 8px;
  }
  .chapter {
    display: flex;
    gap: 12px;
    align-items: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    color: var(--steel-300);
    padding: 8px 12px;
    text-align: left;
    cursor: pointer;
  }
  .chapter:hover {
    border-color: rgba(243, 139, 18, 0.5);
    color: var(--steel-100);
  }
  .chapter-time {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--safety-500);
  }
  @media (max-width: 720px) {
    .player-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .player-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }
  .player-media > :only-child {
    grid-column: 1 / -1;
  }
  .player-youtube {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    aspect-ratio: 16 / 9;
  }
  .player-youtube iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }
  @media (max-width: 720px) {
    .player-media {
      grid-template-columns: 1fr;
    }
  }
</style>
