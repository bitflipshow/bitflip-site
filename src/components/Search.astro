---
// Search component using Pagefind
---

<div class="search-wrapper">
  <div id="search"></div>
</div>

<script>
  // @ts-ignore
  import("/pagefind/pagefind.js")
    .then((module) => {
      const pagefind = module;
      
      // Initialize Pagefind UI
      new pagefind.PagefindUI({
        element: "#search",
        showImages: false,
        showSubResults: true,
        excerptLength: 30,
        processResult: (result) => {
          // Customize result display if needed
          return result;
        },
      });
    })
    .catch((error) => {
      console.error("Failed to load Pagefind:", error);
    });
</script>

<style>
  .search-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--safety-500);
    --pagefind-ui-text: var(--steel-100);
    --pagefind-ui-background: var(--ink-700);
    --pagefind-ui-border: rgba(243, 139, 18, 0.2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-tag: var(--ink-800);
    --pagefind-ui-font: var(--font-body);
  }

  :global(.pagefind-ui__search-input) {
    background: var(--ink-800);
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: var(--radius-md);
    color: var(--steel-100);
    padding: 14px 20px;
    font-size: 1rem;
    font-family: var(--font-body);
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: var(--safety-500);
    outline: none;
    box-shadow: 0 0 0 3px rgba(243, 139, 18, 0.1);
  }

  :global(.pagefind-ui__result) {
    background: rgba(12, 14, 16, 0.6);
    border: 1px solid rgba(243, 139, 18, 0.2);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 16px;
  }

  :global(.pagefind-ui__result:hover) {
    border-color: rgba(243, 139, 18, 0.5);
  }

  :global(.pagefind-ui__result-link) {
    color: var(--steel-100);
    font-weight: 600;
    font-size: 1.1rem;
  }

  :global(.pagefind-ui__result-link:hover) {
    color: var(--safety-500);
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--steel-300);
    margin-top: 8px;
    line-height: 1.5;
  }

  :global(.pagefind-ui__result-title mark),
  :global(.pagefind-ui__result-excerpt mark) {
    background-color: rgba(243, 139, 18, 0.3);
    color: var(--safety-500);
    font-weight: 600;
  }

  :global(.pagefind-ui__message) {
    color: var(--steel-400);
    text-align: center;
    padding: 20px;
  }
</style>