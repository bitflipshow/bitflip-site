---
// Search component using Pagefind
---

<div class="search-wrapper">
  <div id="search"></div>
</div>

<script>
  // Wait for DOM to be ready
  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      import("/pagefind/pagefind.js")
        .then((module) => {
          const pagefind = module;
          
          // Initialize Pagefind UI
          new pagefind.PagefindUI({
            element: "#search",
            showImages: false,
            showSubResults: true,
            excerptLength: 30,
          });
        })
        .catch((error) => {
          console.error("Failed to load Pagefind:", error);
          document.getElementById("search").innerHTML = 
            '<p style="color: var(--steel-400); padding: 20px; text-align: center;">Search is currently unavailable. Please try again later.</p>';
        });
    });
  }
</script>

<style>
  .search-wrapper {
    max-width: 800px;
    margin: 0 auto;
    min-height: 200px;
  }

  :global(.pagefind-ui__search-input) {
    background: var(--ink-800) !important;
    border: 1px solid rgba(243, 139, 18, 0.3) !important;
    border-radius: var(--radius-md) !important;
    color: var(--steel-100) !important;
    padding: 14px 20px !important;
    font-size: 1rem !important;
    font-family: var(--font-body) !important;
    width: 100% !important;
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: var(--safety-500) !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(243, 139, 18, 0.1) !important;
  }

  :global(.pagefind-ui__result) {
    background: rgba(12, 14, 16, 0.6) !important;
    border: 1px solid rgba(243, 139, 18, 0.2) !important;
    border-radius: var(--radius-md) !important;
    padding: 16px !important;
    margin-bottom: 16px !important;
  }

  :global(.pagefind-ui__result:hover) {
    border-color: rgba(243, 139, 18, 0.5) !important;
  }

  :global(.pagefind-ui__result-link) {
    color: var(--steel-100) !important;
    font-weight: 600 !important;
    font-size: 1.1rem !important;
  }

  :global(.pagefind-ui__result-link:hover) {
    color: var(--safety-500) !important;
  }

  :global(.pagefind-ui__result-excerpt) {
    color: var(--steel-300) !important;
    margin-top: 8px !important;
    line-height: 1.5 !important;
  }

  :global(.pagefind-ui__result-title mark),
  :global(.pagefind-ui__result-excerpt mark) {
    background-color: rgba(243, 139, 18, 0.3) !important;
    color: var(--safety-500) !important;
    font-weight: 600 !important;
  }

  :global(.pagefind-ui__message) {
    color: var(--steel-400) !important;
    text-align: center !important;
    padding: 20px !important;
  }

  :global(.pagefind-ui__button) {
    background: var(--safety-500) !important;
    color: var(--ink-900) !important;
    border: none !important;
    border-radius: var(--radius-sm) !important;
    padding: 8px 16px !important;
    font-weight: 600 !important;
  }
</style>