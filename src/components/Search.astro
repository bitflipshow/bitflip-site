---
// Search component using Pagefind Component UI (v1.5.0+)
---

<div class="search-wrapper">
  <pagefind-searchbox></pagefind-searchbox>
</div>

<link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />

<script is:inline>
  function loadPagefind() {
    if (customElements.get('pagefind-searchbox')) return;

    const script = document.createElement('script');
    script.type = 'module';
    script.src = '/pagefind/pagefind-component-ui.js';
    script.onerror = function() {
      const el = document.querySelector('pagefind-search');
      if (el) {
        el.insertAdjacentHTML('afterend',
          '<div class="search-unavailable">' +
          '<div style="font-size:1.5rem;margin-bottom:12px">🔍</div>' +
          '<p style="margin:0 0 8px;font-weight:600;color:var(--steel-100)">Search unavailable</p>' +
          '<p style="margin:0;font-size:0.9rem;color:var(--steel-400)">Run <code style="background:rgba(255,255,255,0.08);padding:2px 6px;border-radius:4px">astro build</code> first to generate the search index.</p>' +
          '</div>'
        );
        el.remove();
      }
    };
    document.head.appendChild(script);
  }

  document.addEventListener('astro:page-load', loadPagefind);
</script>

<style>
  .search-wrapper {
    max-width: 800px;
    margin: 0 auto;
    min-height: 200px;
  }

  .search-unavailable {
    background: rgba(243, 139, 18, 0.06);
    border: 1px solid rgba(243, 139, 18, 0.2);
    border-radius: 14px;
    padding: 32px;
    text-align: center;
    color: var(--steel-300);
  }

  /* Theme the Component UI to match BitFlip */
  pagefind-searchbox {
    --pagefind-ui-primary: var(--safety-500);
    --pagefind-ui-text: var(--steel-100);
    --pagefind-ui-background: var(--ink-800);
    --pagefind-ui-border: rgba(243, 139, 18, 0.3);
    --pagefind-ui-font: var(--font-body);
  }
</style>