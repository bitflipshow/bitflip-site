---
// TranscriptRenderer.astro — CSS only; JS initialization lives in Base.astro
---

<style is:global>
  /* ── Transcript widget ─────────────────────────── */
  .transcript-section {
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .transcript-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    background: var(--card-bg);
    border: none;
    cursor: pointer;
    color: var(--steel-100);
    transition: background 0.2s;
    text-align: left;
    font-family: var(--font-body);
  }

  .transcript-toggle:hover {
    background: rgba(243, 139, 18, 0.06);
  }

  .transcript-toggle[aria-expanded="true"] {
    border-bottom: 1px solid var(--card-border);
  }

  .transcript-toggle-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .transcript-icon {
    font-size: 1.25rem;
    color: var(--safety-500);
    flex-shrink: 0;
  }

  .transcript-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .transcript-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--steel-100);
  }

  .transcript-subtitle {
    font-size: 0.78rem;
    color: var(--meta-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .transcript-chevron {
    color: var(--steel-500);
    font-size: 0.85rem;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .transcript-toggle[aria-expanded="true"] .transcript-chevron {
    transform: rotate(180deg);
  }

  .transcript-body {
    background: rgba(12, 14, 16, 0.5);
  }

  .transcript-toolbar {
    display: flex;
    gap: 8px;
    padding: 12px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .transcript-tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    background: transparent;
    border: 1px solid rgba(243, 139, 18, 0.3);
    border-radius: 999px;
    color: var(--steel-500);
    font-size: 0.78rem;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .transcript-tool-btn:hover {
    border-color: var(--safety-500);
    color: var(--safety-500);
    background: rgba(243, 139, 18, 0.06);
  }

  .transcript-content {
    padding: 20px 24px;
    max-height: 560px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(243, 139, 18, 0.25) transparent;
  }

  .transcript-content::-webkit-scrollbar { width: 5px; }
  .transcript-content::-webkit-scrollbar-track { background: transparent; }
  .transcript-content::-webkit-scrollbar-thumb {
    background: rgba(243, 139, 18, 0.25);
    border-radius: 3px;
  }

  /* ── Dialogue rows ─────────────────────────────── */
  .transcript-dialogue {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .transcript-turn {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0 16px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    transition: background 0.15s;
  }

  .transcript-turn:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .transcript-turn:nth-child(even) {
    background: rgba(255, 255, 255, 0.015);
  }
  .transcript-turn:nth-child(even):hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .turn-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
  }

  .turn-speaker {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .turn-ts {
    font-size: 0.7rem;
    color: var(--steel-500);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .turn-text {
    color: var(--body-text);
    font-size: 0.93rem;
    line-height: 1.65;
  }

  /* ── Per-speaker accent colours ───────────────── */
  .speaker-color-0 .turn-speaker { color: #f38b12; }
  .speaker-color-1 .turn-speaker { color: #60a5fa; }
  .speaker-color-2 .turn-speaker { color: #34d399; }
  .speaker-color-3 .turn-speaker { color: #f472b6; }
  .speaker-color-4 .turn-speaker { color: #a78bfa; }
  .speaker-color-5 .turn-speaker { color: #fb923c; }

  @media (max-width: 560px) {
    .transcript-toggle {
      padding: 16px;
      align-items: flex-start;
    }

    .transcript-toolbar {
      padding: 10px 14px;
    }

    .transcript-content {
      padding: 16px 14px;
      max-height: 60vh;
    }

    .transcript-turn {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 10px 0;
    }
    .turn-meta {
      flex-direction: row;
      align-items: baseline;
      gap: 8px;
    }
  }
</style>
