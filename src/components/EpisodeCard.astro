---
import { formatEpisodeDate } from "../lib/episodes";
import { slugifyTag } from "../lib/tags";
const { episode } = Astro.props;
const { title, episodeNumber, date, summary, duration, tags } = episode.data;
const formattedDate = formatEpisodeDate(date);
---

<article class="episode-card">
  <a href={`/${episodeNumber}`} class="card-link">
    <div class="episode-number">#{episodeNumber}</div>
    <h3 class="episode-title">{title}</h3>
    <p class="episode-summary">{summary}</p>
  </a>
  <div class="episode-meta">
    <div class="date-runtime">
      <span class="date">{formattedDate}</span>
      {duration && <span class="runtime">{duration}</span>}
    </div>
    {tags && tags.length > 0 && (
      <div class="episode-tags">
        {tags.map((tag: string) => (
          <a href={`/tags/${slugifyTag(tag)}`} class="tag">{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .episode-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    transition: var(--transition-card);
  }
  .episode-card:hover {
    border-color: var(--card-border-hover);
    transform: var(--card-hover-transform);
  }
  .card-link {
    padding: 20px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
    text-decoration: none;
  }
  .episode-meta {
    padding: 12px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid rgba(243, 139, 18, 0.1);
    margin-top: auto;
  }
  .episode-number {
    font-size: 0.75rem;
    color: var(--safety-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .episode-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0;
    color: var(--steel-100);
    line-height: 1.3;
  }
  .episode-summary {
    color: var(--body-text);
    line-height: 1.5;
    font-size: 0.95rem;
    flex-grow: 1;
    overflow: hidden;
    margin: 0;
    max-height: calc(1.5em * 4);
    min-height: calc(1.5em * 4);
  }
  .date-runtime {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
  }
  .date, .runtime {
    color: var(--meta-text);
  }
  .episode-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    transition: all 0.2s;
    cursor: pointer;
  }
  .tag:hover {
    background: rgba(243, 139, 18, 0.2);
    border-color: var(--safety-500);
    color: var(--steel-100);
    transform: translateY(-1px);
  }
  .episode-tags:hover ~ * {
    pointer-events: none;
  }
  .episode-card:has(.tag:hover) {
    transform: none;
    border-color: var(--card-border);
  }
</style>