---
import { formatEpisodeDate } from "../lib/episodes";
const { episode } = Astro.props;
const { title, episodeNumber, date, summary, duration, tags } = episode.data;
const formattedDate = formatEpisodeDate(date);
---

<a href={`/${episodeNumber}`} class="episode-card">
  <div class="episode-number">#{episodeNumber}</div>
  <h3 class="episode-title">{title}</h3>
  <p class="episode-summary">{summary}</p>
  <div class="episode-meta">
    <div class="date-runtime">
      <span class="date">{formattedDate}</span>
      {duration && <span class="runtime">{duration}</span>}
    </div>
    {tags && tags.length > 0 && (
      <div class="episode-tags">
        {tags.map((tag) => (
          <span class="tag" key={tag}>{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  .episode-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: var(--transition-card);
  }
  .episode-card:hover {
    border-color: var(--card-border-hover);
    transform: var(--card-hover-transform);
  }
  .episode-number {
    font-size: 0.75rem;
    color: var(--safety-500);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .episode-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0;
    color: var(--steel-100);
    line-height: 1.3;
  }
  .episode-summary {
    color: var(--body-text);
    line-height: 1.5;
    font-size: 0.95rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
  .episode-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(243, 139, 18, 0.1);
    margin-top: auto;
  }
  .date-runtime {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
  }
  .date, .runtime {
    color: var(--meta-text);
  }
  .episode-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    border: 1px solid rgba(243, 139, 18, 0.4);
    color: var(--safety-500);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }
</style>